{
  "name": "stanza",
  "version": "0.1.0",
  "description": "Local macOS LaTeX editor with live PDF and diff-gated Claude block editing",
  "productName": "Stanza",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist": "electron-vite build && electron-builder",
    "typecheck": "tsc --noEmit --composite false -p tsconfig.node.json && tsc --noEmit --composite false -p tsconfig.web.json",
    "test": "vitest run --project shared --project main --project renderer --project tests",
    "test:watch": "vitest",
    "test:integration": "bash scripts/test-integration.sh",
    "test:e2e": "electron-vite build && playwright test"
  },
  "build": {
    "appId": "com.miguelfernandes.stanza",
    "productName": "Stanza",
    "directories": {
      "buildResources": "build"
    },
    "files": [
      "out/**"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity"
    },
    "win": {
      "icon": "build/icon.ico"
    },
    "linux": {
      "icon": "build/icon.png"
    }
  },
  "dependencies": {
    "@codemirror/lint": "^6.9.7",
    "@unified-latex/unified-latex-types": "^1.8.4",
    "@unified-latex/unified-latex-util-parse": "^1.8.4",
    "chokidar": "^5.0.0",
    "codemirror": "^6.0.2",
    "codemirror-lang-latex": "^0.4.1",
    "diff": "^9.0.0",
    "lucide-react": "^1.18.0",
    "nspell": "^2.1.5",
    "pdfjs-dist": "^6.0.227",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.0.10",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^26.1.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.5",
    "vitest": "^3.2.4"
  }
}
